    "Fetch Data useEffect": {
        "prefix": "fetch",
        "scope": "javascript,javascriptreact,typescript,typescriptreact",
        "body": [
            "const [${1:data}, set${1/(.*)/${1:/capitalize}/}] = useState(${2:[]});",
            "const [loading, setLoading] = useState(true);",
            "",
            "useEffect(() => {",
            "  const getData = async () => {",
            "    try {",
            "      const res = await fetch('${3:https://api.example.com/data}');",
            "      const json = await res.json();",
            "      set${1/(.*)/${1:/capitalize}/}(json);",
            "    } catch (err) {",
            "      console.error(err);",
            "    } finally {",
            "      setLoading(false);",
            "    }",
            "  };",
            "  getData();",
            "}, []);",
            "$0"
        ],
        "description": "Fetch data with useEffect"
    },
